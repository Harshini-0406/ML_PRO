{
  "name": "examiq-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install:ml": "py -3.11 -m pip install -r ml-service/requirements.txt",
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:ml",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "dev:ml": "cd ml-service && py -3.11 -m uvicorn app:app --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:ml\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
